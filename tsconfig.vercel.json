{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "server/src/repositories/**/*.ts",
    "server/src/services/**/*.ts",
    "server/src/types/**/*.ts",
    "server/src/validators/**/*.ts"
  ]
}
